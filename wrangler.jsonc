{
    "$schema": "node_modules/wrangler/config-schema.json",
    "main": "@tanstack/react-start/server-entry",
    "name": "webosumania",
    "compatibility_date": "2025-09-08",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "kv_namespaces": [
        {
            "binding": "OSU_API",
            "id": "671bacfde53d4d65aa9abae8232423d3"
        },
        {
            "binding": "BEATMAP_SETS",
            "id": "297ff4b84e29481ebe506e4f1abe185f"
        },
        {
            "binding": "BEATMAP_SET_DATA",
            "id": "48d4fed25a2d4fc78b604538f4fa32d3"
        }
    ],
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": [
                "ApiRateLimit"
            ]
        },
        {
            "tag": "v2",
            "deleted_classes": [
                "ApiRateLimit"
            ]
        },
    ],
    "observability": {
        "logs": {
            "enabled": true
        }
    }
}
